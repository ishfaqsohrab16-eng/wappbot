# ============================================================
# WappBot — WhatsApp data assistant (Evolution API + Ollama + MySQL)
# Copy to .env for local dev. In Easypanel, paste into the app's Environment tab.
# ============================================================

# ---- App ----
PORT=3000
# URL Evolution API uses to reach this app (docker-compose sets it to http://wappbot:3000 for you)
PUBLIC_URL=http://wappbot:3000
DATA_DIR=/app/data
LOG_LEVEL=info

# ---- Dashboard login ----
ADMIN_PASSWORD=change-me
# Long random string (32+ chars). Signs dashboard sessions.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=24

# ---- WhatsApp access control ----
# Comma-separated. Local format is fine (03xx...), converted with DEFAULT_COUNTRY_CODE.
ADMIN_NUMBERS=03337881264
DEFAULT_COUNTRY_CODE=92
# Sent once a day to numbers that are not allowed. Leave empty to stay silent.
UNAUTHORIZED_REPLY=Sorry, you are not authorized to use this bot. Please contact the administrator.
ALLOW_GROUPS=false

# ---- Evolution API (runs inside this stack) ----
# docker-compose sets EVOLUTION_BASE_URL to http://wb-evolution:8080 for you
EVOLUTION_BASE_URL=http://wb-evolution:8080
# Global API key. Evolution is started with this same key.
EVOLUTION_API_KEY=change-me-long-random
# Name of the WhatsApp session. Created automatically on startup.
EVOLUTION_INSTANCE=digibizz
# Random string; part of the webhook URL: <PUBLIC_URL>/webhook/evolution/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-random
# On startup: create the instance if missing and point its webhook here
EVOLUTION_AUTO_SET_WEBHOOK=true
# Password for Evolution's own Postgres (letters and digits only)
EVOLUTION_DB_PASSWORD=change-me-letters-and-digits
EVOLUTION_IMAGE_TAG=v2.3.7

# ---- LLM (local Ollama, fastest setup) ----
# local = Ollama (native API: thinking off, model kept in RAM). google = Gemini (optional).
LLM_PROVIDER=local
LLM_FALLBACK=none
LLM_BASE_URL=http://wp_man_llm:11434/v1
LLM_API_KEY=ollama
# The LLM only routes unknown questions + small talk, so a small model is enough.
# qwen3:4b is ~2x faster than qwen3:8b on CPU. Pulled automatically if missing.
LLM_MODEL=qwen3:4b
LLM_AUTO_PULL=true
# Context window (prompts are small now)
LLM_NUM_CTX=4096
# Keep the model loaded forever (-1) so replies never wait for a cold load
LLM_KEEP_ALIVE=-1
# Thinking makes qwen3 several times slower; keep false
LLM_THINK=false
LLM_MAX_TOKENS=800
# Max tokens for each bot reply (WhatsApp + test chat)
LLM_BOT_MAX_TOKENS=400
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=300000
LLM_CONCURRENCY=2
LLM_MAX_QUEUE=10
LLM_RATE_LIMIT_PER_MIN=10
# Conversation memory per user (saved on disk, survives restarts)
LLM_HISTORY_MESSAGES=30
LLM_HISTORY_DAYS=30
LLM_MAX_USER_CHARS=2000
# SQL attempts per question (fix errors / broaden empty results)
LLM_MAX_AGENT_STEPS=4
# Optional Gemini instead of local
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.0-flash
GOOGLE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_COOLDOWN_MS=900000

# ---- Query engine ----
# Data questions are answered by fixed, parameterized, read-only handlers.
# The LLM never writes SQL; it only classifies unknown phrasings into a plan,
# and successful interpretations are learned (data/learned-queries.json).
ENGINE_LLM_FALLBACK=true
# Below MIN: not saved. MIN..ACTIVE: saved as pending (/approve <id>). Above ACTIVE: used at once.
LEARN_MIN_CONFIDENCE=0.6
LEARN_ACTIVE_CONFIDENCE=0.8
# Cache for counts/breakdowns (person lookups are never cached). 0 = off
RESULT_CACHE_MS=60000
# Files: Excel for long lists, chart images for breakdowns, Word on request
EXPORT_MAX_ROWS=5000
AUTO_EXCEL=true
AUTO_CHART=true
# Trainer punctuality: minutes after class start before a check-in counts as late
TRAINER_LATE_GRACE_MIN=10

# ---- Voice replies (text-to-speech, runs in this stack) ----
# Voice-note questions with short answers get a voice-note reply (English voice).
TTS_BASE_URL=http://wb-tts:8880
TTS_VOICE=af_heart
TTS_MAX_CHARS=350
BOT_VOICE_REPLIES=true

# ---- Database (read-only user) ----
DB_HOST=digibizz_program_program_db
DB_PORT=3306
DB_NAME=lms_lmsdb
DB_USER=readonly_user
DB_PASSWORD=your-db-password
DB_QUERY_TIMEOUT_MS=15000
DB_MAX_ROWS=50
# Optional: only expose these tables to the bot (comma-separated). Empty = all tables.
DB_ALLOWED_TABLES=
# Columns matching this regex are hidden from the bot and blocked in queries.
DB_BLOCKED_COLUMNS_REGEX=pass|pwd|token|secret|salt|hash|otp|api_?key|remember
# Hints that make the bot much smarter about YOUR data, e.g.
# "students.std_cnic holds CNIC; batches.batch_no is the batch number; status 1 = active"
DB_SCHEMA_NOTES=

# ---- Speech-to-text (voice messages, Whisper runs inside this stack) ----
# small = fast on CPU; medium = better Urdu, 2-3x slower
WHISPER_MODEL=small
# Max CPU cores Whisper may use, so the LLM keeps the rest
WHISPER_CPUS=4
WHISPER_IMAGE_TAG=v1.10.0
# whisper-asr = built-in Whisper | openai = any /v1/audio/transcriptions API | none
# docker-compose sets STT_PROVIDER/STT_BASE_URL for the built-in Whisper
STT_PROVIDER=whisper-asr
STT_BASE_URL=http://wb-whisper:9000
STT_API_KEY=
STT_MODEL=whisper-1
STT_TIMEOUT_MS=120000
STT_MAX_AUDIO_SECONDS=180
# Empty = auto-detect (Hindi/Devanagari results are redone as Urdu). Set "ur" to always transcribe as Urdu.
STT_LANGUAGE=
# Optional domain words that help Whisper spell names (leave unset for the built-in list)
# STT_PROMPT=

# ---- Bot behaviour ----
BOT_NAME=DigiBizz Assistant
BOT_CONTEXT_NOTE=You answer questions about an LMS (learning management system) database.
# Send "working on it" if a reply takes longer than this
BOT_ACK_AFTER_MS=10000
BOT_WELCOME_ON_ADD=true
BOT_ECHO_TRANSCRIPT=true
# Show what the bot understood / is doing on WhatsApp (never SQL or schema)
BOT_SHOW_THINKING=true
